# העתיקו ל-.env ומלאו. הקובץ .env נשאר אצלכם ולעולם לא עולה לריפו (מכוסה ב-.gitignore).
# Copy to .env and fill in. .env stays on your machine and is never committed.

# תעודת זהות של ההורה או התלמיד במשו״ב
MASHOV_USERNAME=
# סיסמת משו״ב. נשמרת רק אצלכם, בסביבה המקומית.
MASHOV_PASSWORD=
# קוד בית הספר (סמל). רשימת בתי הספר: python -m daily_brief --schools
MASHOV_SEMEL=
# שנת הלימודים כפי שמשו״ב מצפה (למשל 2026 לשנת תשפ״ו)
MASHOV_YEAR=2026
# ילדים: שם=מזהה תלמיד, מופרדים בפסיקים
MASHOV_KIDS=דנה=123456,איתמר=123457
# כמה הודעות אחרונות למשוך ממשו״ב (ברירת מחדל 10)
MASHOV_MESSAGES_TAKE=10
# אופציונלי: יומן ICS להצלבה (נתיב קובץ מקומי או URL ציבורי)
BRIEF_ICS=
# קובץ מצב מקומי לסמן ריצה אחרונה (אידמפוטנטות, סימון הודעות חדשות)
BRIEF_STATE=out/state.json
